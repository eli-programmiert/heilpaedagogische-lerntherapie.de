.env
.env.production

# Client Assets (the practice photos in praxis/ are tracked, see below)
src/assets/raw/*
!src/assets/raw/.gitkeep
!src/assets/raw/praxis/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Lighthouse reports are generated evidence, not source files.
audit-reports/lighthouse-*
audit-reports/

# Editor settings
.vscode/

dev-server.log

# input for the website received by Eli
.content
