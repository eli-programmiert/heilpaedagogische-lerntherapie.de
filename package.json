{
  "name": "heilpaedagogische-lerntherapie",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node src/scripts/sync-phosphor-css.mjs",
    "dev": "astro dev",
    "postinstall": "node src/scripts/sync-phosphor-css.mjs",
    "prebuild": "node src/scripts/sync-phosphor-css.mjs",
    "build": "npm run assets:gen && npm run assets:fonts && npm run assets:img && astro build && node src/scripts/prune-images.mjs && node src/scripts/strip-html-comments.mjs && node src/scripts/prune-phosphor-css.mjs && node scripts/prefix-base-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:hardcoded": "tsx src/scripts/check-hardcoded.ts",
    "check:types": "astro check --minimumSeverity error",
    "check:motion": "tsx src/scripts/check-legacy-motion.ts",
    "check:icons": "node src/scripts/prune-phosphor-css.mjs --check",
    "check:atomic": "tsx src/scripts/check-atomic-design.ts",
    "check:atomic:full": "tsx src/scripts/check-atomic-design.ts --scan-dirs src/components",
    "check:imports": "tsx src/scripts/check-import-paths.ts",
    "check:registrations": "tsx src/scripts/check-registrations.ts",
    "design:sync": "tsx src/scripts/sync-design.ts",
    "design:lint": "design.md lint design/*.md",
    "design:spec": "design.md spec design/nova.md --output public/design-spec",
    "assets:gen": "node src/scripts/generate-favicons.cjs",
    "assets:img": "tsx src/scripts/optimize-images.ts",
    "assets:fonts": "tsx src/scripts/download-fonts.ts",
    "test": "vitest",
    "test:mobile": "vitest run src/utils/mobile-layout-audit.test.ts",
    "check:mobile": "tsx src/scripts/check-mobile-layout.ts",
    "check:baseline-update": "tsx src/scripts/generate-baseline.ts",
    "check:content": "tsx src/scripts/check-content.ts",
    "check:seo": "tsx src/scripts/check-seo.ts",
    "check:seo:client": "tsx src/scripts/check-seo.ts --client",
    "check:links": "tsx src/scripts/check-links.ts",
    "check:page-registry": "tsx src/scripts/check-page-registry.ts",
    "check:data": "tsx src/scripts/check-data-contracts.ts",
    "ai:check": "npm run check:types && npm run check:data && npm run check:imports && npm run check:registrations && npm run check:motion && npm run test -- --run",
    "check:images": "tsx src/scripts/check-images.ts",
    "build:prod": "npm run build",
    "qa": "tsx src/scripts/run-qa.ts qa",
    "qa:strict": "tsx src/scripts/run-qa.ts strict",
    "qa:client": "tsx src/scripts/run-qa.ts client",
    "qa:help": "tsx src/scripts/run-qa.ts help",
    "audit:lighthouse": "node src/scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "fast-glob": "^3.3.3",
    "shadcn": "^4.13.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@google/design.md": "^0.1.1",
    "@types/js-yaml": "^4.0.9",
    "cheerio": "^1.2.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
