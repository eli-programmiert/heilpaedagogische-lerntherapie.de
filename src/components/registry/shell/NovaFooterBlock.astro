---
import Text from "@components/ui/atoms/Text.astro";
import PraxisLogo from "@components/ui/atoms/PraxisLogo.astro";
import company from "@data/global/company.json";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

interface Props {
  locale?: NovaLocale;
}

const { locale = "de" } = Astro.props as Props;
const copy = getNovaCopy(locale).footer;
const phone = getNovaCopy(locale).navigation.phone;
const pageLinks = copy.pages.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
const legalLinks = copy.legalLinks.map((link) => ({ ...link, href: getNovaNavigationPath(link.href, locale) }));
const year = new Date().getFullYear();
---

<!-- Why: footer stays on the cream base tone (no dark sections in Nova). -->
<footer class="praxis-footer ui-bg-base border-t border-brand-dark/10">
  <div class="ui-container grid gap-12 py-14 md:grid-cols-[1.4fr_0.8fr_1fr] md:gap-10 lg:py-20">
    <div class="flex flex-col gap-5">
      <a href={getNovaNavigationPath("/", locale)} class="w-fit" aria-label={getNovaCopy(locale).navigation.aria.home}>
        <PraxisLogo />
      </a>
      <Text tag="p" variant="feature-body-sm" class="font-semibold text-brand-primary">{copy.claim}</Text>
      <Text tag="p" variant="feature-body-sm" class="max-w-sm text-brand-dark/75">{copy.about}</Text>
      <Text tag="p" variant="feature-body-sm" class="text-brand-dark/75">{copy.hours}</Text>
    </div>

    <nav aria-label={copy.ariaPages}>
      <Text tag="p" variant="accent-label" class="praxis-eyebrow mb-4">{copy.pagesTitle}</Text>
      <ul class="flex flex-col gap-2">
        {pageLinks.map((link) => (
          <li><a href={link.href} class="praxis-footer__link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <Text tag="p" variant="accent-label" class="praxis-eyebrow mb-4">{copy.contactTitle}</Text>
      <address class="flex flex-col gap-1 not-italic text-brand-dark/80">
        <span class="font-semibold text-brand-dark">{company.owner}</span>
        <span>{company.address}</span>
        <span>{company.zipCode} {company.city}</span>
        <a href={phone.href} class="praxis-footer__link mt-2">{phone.label}</a>
        <a href={`mailto:${company.email}`} class="praxis-footer__link break-all">{company.email}</a>
        <a href={company.socials.instagram} class="praxis-footer__link mt-2 inline-flex items-center gap-2" target="_blank" rel="noopener noreferrer" aria-label={copy.instagramLabel}>
          <i class="ph ph-instagram-logo text-xl" aria-hidden="true"></i>
          <span>Instagram</span>
        </a>
      </address>
    </div>
  </div>

  <div class="ui-container">
    <div class="flex flex-col gap-3 border-t border-brand-dark/10 py-6 text-sm text-brand-dark/70 md:flex-row md:items-center md:justify-between">
      <Text tag="p" variant="feature-body-sm">{copy.disclaimer}</Text>
      <nav aria-label={copy.ariaLegal} class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>© {year} {company.owner}</span>
        {legalLinks.map((link) => (
          <a href={link.href} class="praxis-footer__link">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .praxis-footer {
    --praxis-logo-band: var(--color-brand-light);
  }

  .praxis-footer__link {
    color: var(--color-brand-dark);
    transition: color 200ms ease;
  }

  .praxis-footer__link:hover,
  .praxis-footer__link:focus-visible {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
