---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Text from "@components/ui/atoms/Text.astro";
import SectionIntro from "@components/ui/molecules/SectionIntro.astro";

// Why: unit prices as a semantic table. On phones the duration moves under
// the service name; prices use tabular figures and stay right-aligned.
interface Props {
  id?: string;
  tone?: "page" | "base";
  eyebrow?: string;
  title: string;
  caption?: string;
  rows: { service: string; duration?: string; price: string }[];
  footnote?: string;
  headingTag?: string;
}

const { id = "einzelleistungen", tone = "base", eyebrow, title, caption, rows, footnote, headingTag = "h2" } = Astro.props as Props;
---

<Section id={id} tone={tone}>
  <Container>
    <div class="mx-auto max-w-4xl">
      <SectionIntro eyebrow={eyebrow} title={title} headingTag={headingTag} />
      <div class="mt-10 overflow-hidden rounded-xl border border-brand-dark/10 bg-white">
        <table class="praxis-prices w-full border-collapse text-left">
          {caption && <caption class="sr-only">{caption}</caption>}
          <thead class="sr-only">
            <tr>
              <th scope="col">Leistung</th>
              <th scope="col">Dauer</th>
              <th scope="col">Preis</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="border-b border-brand-dark/10 last:border-b-0">
                <th scope="row" class="px-5 py-4 font-medium text-brand-dark sm:px-7 sm:py-5">
                  <span class="block">{row.service}</span>
                  {row.duration && <span class="mt-0.5 block text-sm font-normal text-brand-dark/65 sm:hidden">{row.duration}</span>}
                </th>
                <td class="hidden whitespace-nowrap px-4 py-4 text-brand-dark/70 sm:table-cell sm:py-5">{row.duration ?? ""}</td>
                <td class="whitespace-nowrap px-5 py-4 text-right font-heading text-lg font-semibold text-brand-primary tabular-nums sm:px-7 sm:py-5">{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {footnote && <Text variant="feature-body-sm" class="mt-4 text-brand-dark/70">{footnote}</Text>}
    </div>
  </Container>
</Section>
