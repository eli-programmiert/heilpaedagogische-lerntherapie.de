---
import Layout from "./Layout.astro";
import Heading from "@/components/ui/atoms/Heading.astro";
import legalData from "@data/global/legal.json";
import { getNovaNavigationPath } from "@utils/nova-i18n";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const legalCopy = legalData.de;
const homeHref = getNovaNavigationPath("/");
---

<!-- Why: legal pages reuse the site shell; main content receives header
     spacing because the floating navbar overlays the page background. -->
<Layout
  title={title}
  description={description}
  navbarVariant="floating"
  footerVariant="nova"
>
  <div class="ui-bg-page pb-16 pt-8 lg:pb-24 lg:pt-12">
    <div class="ui-container">
      <div class="mx-auto max-w-3xl">
        <div class="mb-10 border-b border-brand-dark/10 pb-8">
          <a href={homeHref} class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-brand-dark/70 transition-colors hover:text-brand-primary">
            <i class="ph ph-arrow-left" aria-hidden="true"></i>
            {legalCopy.legalBackLabel}
          </a>
          <Heading level={1} variant="section-heading-xl">{title}</Heading>
        </div>

        <div class="legal-content">
          <slot />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .legal-content h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-brand-primary);
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .legal-content h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-brand-primary);
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .legal-content p {
    margin-bottom: 1.25rem;
    color: var(--ui-text-on-light);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .legal-content a {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    word-break: break-word;
  }

  .legal-content ul,
  .legal-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
  }

  .legal-content ul {
    list-style: disc;
  }

  .legal-content ol {
    list-style: decimal;
  }

  .legal-content li {
    margin-bottom: 0.5rem;
    color: var(--ui-text-on-light);
    line-height: 1.7;
  }

  .legal-content li::marker {
    color: var(--color-brand-accent);
  }
</style>
