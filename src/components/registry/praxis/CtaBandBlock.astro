---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Button from "@components/ui/atoms/Button.astro";
import LogoRings from "@components/decorations/LogoRings.astro";
import RichText from "@components/ui/molecules/RichText.astro";

// Why: closing call to action at the end of every content page, the one blue
// band per page (design brief). The band uses the navy primary instead of the
// light-blue accent: white text on #448cc8 only reaches 3.4:1 (WCAG AA fails).
interface Props {
  id?: string;
  title: string;
  text?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  headingTag?: string;
}

const { id = "kontakt-aufnehmen", title, text, primary, secondary, headingTag = "h2" } = Astro.props as Props;
---

<Section id={id} tone="page" class="praxis-section-compact">
  <Container>
    <div class="praxis-cta relative overflow-hidden rounded-[2rem] bg-brand-primary px-6 py-14 text-center sm:px-12 lg:py-20">
      <LogoRings tone="light" class="absolute -left-16 -top-20 w-72" />
      <LogoRings tone="light" class="absolute -bottom-24 -right-12 w-80 rotate-180" />
      <div class="relative mx-auto flex max-w-2xl flex-col items-center gap-5">
        <Heading tag={headingTag} variant="section-heading-lg" class="praxis-cta__title">{title}</Heading>
        {text && <RichText text={text} variant="lead" class="praxis-cta__text" />}
        <div class="mt-3 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
          <Button href={primary.href} variant="light" size="lg">{primary.label}</Button>
          {secondary && (
            <Button href={secondary.href} variant="outline-light" size="lg">
              <Fragment slot="icon-left">{secondary.href.startsWith("tel:") && <i class="ph ph-phone" aria-hidden="true"></i>}</Fragment>
              {secondary.label}
            </Button>
          )}
        </div>
      </div>
    </div>
  </Container>
</Section>

<style>
  .praxis-cta :global(.praxis-cta__title) {
    color: var(--color-brand-light);
  }

  .praxis-cta :global(.praxis-cta__text) {
    color: var(--color-brand-light);
  }
</style>
