---
import PraxisLogo from "@components/ui/atoms/PraxisLogo.astro";
import MenuToggle from "@components/ui/molecules/Navbar/shared/MenuToggle.astro";
import type { NavTheme } from "@components/ui/molecules/Navbar/shared/nav-theme-classes";
import { getNovaCopy, getNovaNavigationPath, type NovaLocale } from "@utils/nova-i18n";

export interface Props {
	theme?: NavTheme;
	locale?: NovaLocale;
}

const { locale = "de" } = Astro.props;
const headerData = getNovaCopy(locale).navigation;

type MenuItem = {
	label: string;
	href: string;
	children?: { label: string; href: string }[];
};

const menu = headerData.menu as MenuItem[];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && currentPath.startsWith(href.replace(/#.*$/, ""));

// Why: the floating navbar has two states. The static bar sits at the top of
// the page; after scrolling, a fixed copy slides in. Both share this markup,
// so it is rendered from one template below.
const bars: { attr: Record<string, string>; fixed: boolean }[] = [
	{ attr: { "data-site-header": "", "data-site-header-static": "" }, fixed: false },
	{ attr: { "data-site-header-fixed": "", "aria-hidden": "true" }, fixed: true },
];
---

{bars.map(({ attr, fixed }) => (
	<header
		{...attr}
		transition:animate="none"
		class:list={[
			"praxis-header left-0 top-0 w-full",
			fixed
				? "pointer-events-none fixed z-[1000] -translate-y-full opacity-0 shadow-lg backdrop-blur-md will-change-transform"
				: "absolute z-[100]",
		]}
	>
		<div class="ui-container">
			<div class="flex items-center justify-between gap-3 py-3 lg:gap-6" data-nav-inner>
				<a href={getNovaNavigationPath("/", locale)} class="relative z-[1010] flex min-w-0 shrink-0 items-center" aria-label={headerData.aria.home} tabindex={fixed ? -1 : undefined}>
					<PraxisLogo size="compact" />
				</a>

				<nav class="hidden min-w-0 flex-1 items-center justify-center gap-6 xl:flex" aria-label={headerData.aria.navMain}>
					{menu.map((item) => item.children?.length ? (
						<div class="praxis-nav-dropdown relative">
							<a href={getNovaNavigationPath(item.href, locale)} class:list={["ui-nav-bar-link praxis-nav-link", isCurrent(item.href) && "is-current"]} aria-haspopup="true" tabindex={fixed ? -1 : undefined}>
								{item.label}
								<i class="ph ph-caret-down ml-1 text-xs" aria-hidden="true"></i>
							</a>
							<div class="praxis-nav-dropdown__panel">
								<ul class="flex flex-col gap-1">
									{item.children.map((child) => (
										<li>
											<a href={getNovaNavigationPath(child.href, locale)} class="praxis-nav-dropdown__link" tabindex={fixed ? -1 : undefined}>{child.label}</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					) : (
						<a href={getNovaNavigationPath(item.href, locale)} class:list={["ui-nav-bar-link praxis-nav-link", isCurrent(item.href) && "is-current"]} aria-current={isCurrent(item.href) ? "page" : undefined} tabindex={fixed ? -1 : undefined}>
							{item.label}
						</a>
					))}
				</nav>

				<div class="relative z-[1010] flex shrink-0 items-center gap-3">
					<a href={headerData.phone.href} class="praxis-nav-phone hidden items-center gap-1.5 lg:inline-flex" tabindex={fixed ? -1 : undefined}>
						<i class="ph ph-phone" aria-hidden="true"></i>
						<span class="sr-only">{headerData.aria.phone}:</span>
						{headerData.phone.label}
					</a>
					<a href={getNovaNavigationPath(headerData.cta.href, locale)} class="ui-button ui-button-primary ui-nav-cta hidden sm:flex" tabindex={fixed ? -1 : undefined}>
						<span class="ui-button-text-wrap">
							<span class="ui-button-text-default ui-type-cta-label">{headerData.cta.label}</span>
							<span class="ui-button-text-hover ui-type-cta-label" aria-hidden="true">{headerData.cta.hoverLabel}</span>
						</span>
					</a>
					<MenuToggle locale={locale} mobileOnly={false} class="xl:hidden" />
				</div>
			</div>
		</div>
	</header>
))}

<style>
	.praxis-header {
		border-bottom: 1px solid transparent;
		background: var(--color-surface);
		color: var(--color-on-surface);
	}

	[data-site-header-fixed] {
		border-bottom-color: var(--color-outline-variant);
		background: color-mix(in oklab, var(--color-surface) 94%, transparent);
		transition:
			translate 0.35s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.35s ease-out;
	}

	[data-site-header-fixed].is-visible {
		opacity: 1;
		pointer-events: auto;
		translate: 0 0;
	}

	.praxis-header .ui-container {
		max-width: 90rem;
	}

	.praxis-nav-link {
		color: var(--color-brand-dark);
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 600;
		opacity: 0.85;
	}

	.praxis-nav-link:hover,
	.praxis-nav-link.is-current {
		color: var(--color-brand-primary);
		opacity: 1;
	}

	.praxis-nav-link.is-current::after {
		left: 0;
		width: 100%;
	}

	.praxis-nav-dropdown__panel {
		position: absolute;
		top: 100%;
		left: 50%;
		z-index: 20;
		min-width: 16rem;
		padding-top: 0.75rem;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 0.25rem);
		transition: opacity 200ms ease, transform 200ms ease;
	}

	.praxis-nav-dropdown__panel ul {
		padding: 0.5rem;
		border: 1px solid var(--color-outline-variant);
		border-radius: var(--ui-radius-md);
		background: var(--color-surface);
		box-shadow: var(--ui-elevation-soft);
	}

	.praxis-nav-dropdown:hover .praxis-nav-dropdown__panel,
	.praxis-nav-dropdown:focus-within .praxis-nav-dropdown__panel {
		opacity: 1;
		pointer-events: auto;
		transform: translate(-50%, 0);
	}

	.praxis-nav-dropdown__link {
		display: block;
		padding: 0.55rem 0.85rem;
		border-radius: var(--ui-radius-sm);
		color: var(--color-brand-dark);
		font-size: 0.95rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.praxis-nav-dropdown__link:hover,
	.praxis-nav-dropdown__link:focus-visible {
		background: var(--color-brand-cream);
		color: var(--color-brand-primary);
	}

	.praxis-nav-phone {
		color: var(--color-brand-primary);
		font-size: 0.95rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.praxis-nav-phone:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.praxis-header .ui-nav-cta {
		border-radius: 9999px;
		font-family: var(--font-sans);
		letter-spacing: 0.02em;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-site-header-fixed],
		.praxis-nav-dropdown__panel {
			transition: none;
		}
	}
</style>
