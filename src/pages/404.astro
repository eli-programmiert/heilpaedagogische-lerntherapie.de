---
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import LogoRings from "@components/decorations/LogoRings.astro";
import notFound from "@data/pages/404.json";
---

<!-- GitHub Pages serves dist/404.html for every unknown URL. -->
<Layout title={notFound.seo.title} description={notFound.seo.description} noIndex navbarVariant="floating" footerVariant="nova">
  <Section tone="page" class="relative flex min-h-[60vh] items-center overflow-hidden">
    <LogoRings class="absolute left-1/2 top-1/2 w-[28rem] -translate-x-1/2 -translate-y-1/2" />
    <Container class="relative text-center">
      <Text tag="p" variant="accent-label" class="praxis-eyebrow mb-6 justify-center">Fehler 404</Text>
      <Heading tag="h1" variant="section-heading-lg" class="mx-auto max-w-2xl">{notFound.heading}</Heading>
      <Text variant="lead" class="mx-auto mt-5 max-w-lg">{notFound.body}</Text>
      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={notFound.cta1.href} variant="primary" size="lg">{notFound.cta1.label}</Button>
        <Button href={notFound.cta2.href} variant="outline" size="lg">{notFound.cta2.label}</Button>
      </div>
    </Container>
  </Section>
</Layout>
