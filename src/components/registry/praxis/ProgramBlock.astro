---
import Section from "@components/ui/layout/Section.astro";
import Container from "@components/ui/layout/Container.astro";
import Heading from "@components/ui/atoms/Heading.astro";
import Text from "@components/ui/atoms/Text.astro";
import Button from "@components/ui/atoms/Button.astro";
import Icon from "@components/ui/atoms/Icon.astro";

// Why: highlighted programme card ("Fokus & Familie") with price and steps.
// Rendered as its own section directly after the ADHS offer, same tone.
interface Props {
  id?: string;
  tone?: "page" | "base";
  eyebrow?: string;
  title: string;
  meta?: string[];
  price?: string;
  steps: { title: string; description: string; icon?: string }[];
  cta?: { label: string; href: string };
  headingTag?: string;
}

const { id, tone = "page", eyebrow, title, meta = [], price, steps, cta } = Astro.props as Props;
---

<Section id={id} tone={tone} class="praxis-section-flush-top">
  <Container>
    <article class="rounded-[2rem] border-2 border-brand-accent/50 ui-bg-base p-6 sm:p-10 lg:p-12">
      <header class="flex flex-col gap-4 border-b border-brand-dark/10 pb-8 md:flex-row md:items-end md:justify-between">
        <div class="flex flex-col gap-3">
          {eyebrow && <Text tag="p" variant="accent-label" class="praxis-eyebrow">{eyebrow}</Text>}
          <Heading tag="h3" variant="section-heading-lg">{title}</Heading>
          {meta.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {meta.map((entry) => (
                <li class="rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-brand-primary">{entry}</li>
              ))}
            </ul>
          )}
        </div>
        {price && <Text tag="p" class="whitespace-nowrap font-heading text-4xl font-semibold text-brand-primary md:text-5xl">{price}</Text>}
      </header>

      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {steps.map((step, index) => (
          <li class="flex flex-col gap-2 rounded-xl bg-white p-5">
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-brand-primary text-lg text-white" aria-hidden="true">
                {step.icon ? <Icon name={step.icon} /> : index + 1}
              </span>
              <Text tag="span" variant="feature-body-sm" class="font-semibold text-brand-dark/60">Schritt {index + 1}</Text>
            </div>
            <Heading tag="h4" variant="feature-title" class="text-brand-primary">{step.title}</Heading>
            <Text variant="feature-body-sm" class="text-brand-dark/80">{step.description}</Text>
          </li>
        ))}
      </ol>

      {cta && (
        <div class="mt-8">
          <Button href={cta.href} variant="primary" size="lg">{cta.label}</Button>
        </div>
      )}
    </article>
  </Container>
</Section>
