docs/website-brief

# Site assets the CI build needs (GitHub Pages builds from the repo).
# Generated variants in public/assets/images/ stay ignored; `npm run build`
# recreates them from src/assets/raw/.
!src/assets/raw/praxis/*.webp
!public/fonts/*.woff2
!public/favicon.svg
!public/icon.svg
!public/logo.svg
!public/favicon.ico
!public/favicon-32x32.png
!public/apple-touch-icon.png
!public/og-image.png
