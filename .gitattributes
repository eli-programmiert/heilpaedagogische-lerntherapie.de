# Normalise line endings: all text files use LF (also on Windows).
# Prevents commits that only change line endings.
* text=auto eol=lf

# Binary files, no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
