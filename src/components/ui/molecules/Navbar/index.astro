---
import NavStyles from "./shared/NavStyles.astro";
import Floating from "./layouts/Floating.astro";
import type { NavTheme } from "./shared/nav-theme-classes";
import type { NovaLocale } from "@utils/nova-i18n";

export type NavbarLayout = "floating";

interface Props {
	layout?: NavbarLayout;
	theme?: NavTheme;
	locale?: NovaLocale;
}

const { theme = "transparent", locale = "de" } = Astro.props;
---

<NavStyles />
<Floating theme={theme} locale={locale} />

<!-- Navbar JS lives in Layout.astro -->
